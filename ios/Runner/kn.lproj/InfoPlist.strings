NSCameraUsageDescription = "ಈ ಅಪ್ಲಿಕೇಶನ್‌ಗೆ QR ಕೋಡ್ ಅಥವಾ ಬಾರ್‌ಕೋಡ್ ಸ್ಕ್ಯಾನರ್ ವೈಶಿಷ್ಟ್ಯಕ್ಕಾಗಿ ಕ್ಯಾಮರಾಗೆ ಪ್ರವೇಶದ ಅಗತ್ಯವಿದೆ, ಅದನ್ನು ಹುಡುಕಾಟ ಪಟ್ಟಿಯಿಂದ ಪ್ರವೇಶಿಸಬಹುದು";
NSPhotoLibraryAddUsageDescription = "ನಿಮ್ಮ ಫೋಟೋ ಲೈಬ್ರರಿಯಲ್ಲಿ ಚಿತ್ರ/ವೀಡಿಯೊಗಳನ್ನು ಸಂಗ್ರಹಿಸಲು ನಾವು ಪ್ರವೇಶವನ್ನು ಬಯಸುತ್ತೇವೆ";
